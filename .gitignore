# ============================================
# DevOps Deployment Project - .gitignore
# ============================================

# ============================================
# Python
# ============================================

# Virtual environments
venv/
env/
ENV/
.venv
.env

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
*.egg-info/
dist/
build/
*.egg

# PyInstaller
*.manifest
*.spec

# Unit test / coverage
.pytest_cache/
.coverage
htmlcov/
.tox/

# Django stuff
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
/staticfiles/
/media/

# ============================================
# Node.js / React
# ============================================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Production builds
/build
/dist

# Environment variables
.env.local
.env.development.local
.env.test.local
.env.production.local

# ============================================
# IDEs and Editors
# ============================================

# VSCode
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# ============================================
# Operating System
# ============================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~
.directory

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ============================================
# Secrets and Credentials (CRITICAL!)
# ============================================

# Never commit these!
*.pem
*.key
*.env
secrets.yaml
credentials.json

# ============================================
# Database
# ============================================

# MySQL dumps
*.sql
*.sql.gz

# SQLite databases
*.db
*.sqlite

# ============================================
# Logs and Temporary Files
# ============================================

# Application logs
*.log
logs/

# Temporary files
*.tmp
*.temp
*.bak
*.swp

# ============================================
# DevOps / Deployment
# ============================================

# Docker
docker-compose.override.yml

# Terraform
.terraform/
*.tfstate
*.tfstate.backup

# Nginx logs
nginx-access.log
nginx-error.log
